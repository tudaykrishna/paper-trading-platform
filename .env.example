# ---- Core ----
ENV=dev
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Database ----
POSTGRES_USER=paper
POSTGRES_PASSWORD=paper
POSTGRES_DB=paper_trading
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Async URL used by the app; Alembic derives its own from the same parts.
DATABASE_URL=postgresql+asyncpg://paper:paper@localhost:5432/paper_trading

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Wallet ----
OPENING_BALANCE=1000000

# ---- Market data provider ----
# provider: upstox | mock
MARKET_DATA_PROVIDER=mock
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/instruments/upstox/callback
UPSTOX_ACCESS_TOKEN=

# ---- Execution engine ----
SLIPPAGE_BPS=0

# ---- Margin model (paper approximation, not SPAN) ----
MIS_EQUITY_LEVERAGE=5
FUT_MARGIN_PCT=0.20
OPTION_SELL_MARGIN_PCT=0.15

# ---- Order validation ----
# reject orders placed outside the segment's trading hours / on holidays
ENFORCE_MARKET_HOURS=false

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000
